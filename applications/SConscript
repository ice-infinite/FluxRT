# FluxRT —— 应用层构建描述（SCons 侧）。
# FluxRT - application-layer build description (SCons side).
#
# 职责 / Responsibility: 把 applications/ 下的全部 .c 编成一组，并用 Glob 而不是
# 逐个列举，使新增的应用源文件自动参与构建（代价是新文件的编译选项差异需要额外处理）。
# Builds every .c under applications/ as one group, using Glob rather than an explicit list
# so a new application file is picked up automatically; the trade-off is that per-file
# compile-option differences need explicit handling.
#
# 上下文 / Context: 本组包含 Shell 命令层，是操作者唯一入口；它**不**含实时路径，
# 12 kHz 的 ISR 在 foc/platform/stm32g431/ 里。
# This group contains the shell command layer, the operator's only entry point. It does
# not contain the realtime path: the 12 kHz ISR lives in foc/platform/stm32g431/.
from building import *

cwd = GetCurrentDir()
src = Glob('*.c')

# P4.2 motion management is part of the same Diagnostic-only candidate as the
# C adapter/Rust feature.  Keep the source out of generated default/profile
# builds altogether so a newly added application file cannot create hidden
# adapter references while the Kconfig option is off.
if not GetDepend('FOC_MOTION_CONTROL_CANDIDATE'):
    src = [unit for unit in src
           if str(unit).replace('\\', '/').split('/')[-1] !=
           'foc_motion_management.c']

if not GetDepend('FOC_POWER_MANAGEMENT_CANDIDATE'):
    src = [unit for unit in src
           if str(unit).replace('\\', '/').split('/')[-1] !=
           'foc_power_management.c']

# P2.4 external I/O is a real, default-off framework rather than a collection
# of empty driver switches.  Keep every service out of the target image until
# the framework master option is selected; physical transport/input features
# are added only together with their implementations in P2.5+.
if not GetDepend('FOC_EXTERNAL_IO_FRAMEWORK'):
    external_io_sources = {
        'foc_transport_service.c',
        'foc_input_service.c',
        'foc_command_service.c',
        'foc_command_rust_adapter.c',
        'foc_external_command_owner.c',
        'foc_external_io_management.c',
        'foc_external_input_owner.c',
        'foc_native_fake_driver.c',
    }
    src = [unit for unit in src
           if str(unit).replace('\\', '/').split('/')[-1] not in
           external_io_sources]

simple_input_features = (
    GetDepend('FLUXRT_INPUT_PWM_PULSE') or
    GetDepend('FLUXRT_INPUT_ANALOG') or
    GetDepend('FLUXRT_INPUT_STEP_DIR')
)
if not simple_input_features:
    src = [unit for unit in src
           if str(unit).replace('\\', '/').split('/')[-1] !=
           'foc_simple_input_adapter.c']

if not GetDepend('FLUXRT_PROTOCOL_NATIVE'):
    src = [unit for unit in src
           if str(unit).replace('\\', '/').split('/')[-1] !=
           'foc_native_fake_driver.c']

group = DefineGroup(
    'Applications',
    src,
    depend=[''],
    CPPPATH=[cwd],
)

Return('group')
