{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "FluxRT: 增量编译",
      "type": "shell",
      "command": "powershell",
      "args": ["-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}\\build.ps1", "-BuildOnly"],
      "group": {"kind": "build", "isDefault": true},
      "problemMatcher": "$gcc"
    },
    {
      "label": "FluxRT: 重新生成并完整编译",
      "type": "shell",
      "command": "powershell",
      "args": ["-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}\\build.ps1", "-Regenerate"],
      "problemMatcher": "$gcc"
    },
    {
      "label": "FluxRT: Production 候选完整编译",
      "type": "shell",
      "command": "powershell",
      "args": ["-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}\\build.ps1", "-Regenerate", "-Profile", "Production", "-RustOptLevel", "s"],
      "problemMatcher": "$gcc"
    },
    {
      "label": "FluxRT: C + Rust 全部测试",
      "type": "shell",
      "command": "powershell",
      "args": ["-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}\\test.ps1"],
      "problemMatcher": "$gcc"
    },
    {
      "label": "FluxRT: Rust Clippy",
      "type": "shell",
      "command": "${env:USERPROFILE}\\.cargo\\bin\\cargo.exe",
      "args": ["clippy", "--manifest-path", "${workspaceFolder}\\rust\\Cargo.toml", "--workspace", "--all-targets", "--", "-D", "warnings"],
      "problemMatcher": "$rustc"
    },
    {
      "label": "FluxRT: DengFOC USB-only 角度诊断编译",
      "type": "shell",
      "command": "powershell",
      "args": ["-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}\\targets\\esp32_dengfoc\\build.ps1"],
      "problemMatcher": "$gcc"
    },
    {
      "label": "FluxRT: DengFOC USB-only PWM准备编译",
      "type": "shell",
      "command": "powershell",
      "args": ["-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}\\targets\\esp32_dengfoc\\build.ps1", "-Environment", "dengfoc_usb_pwm_prepare"],
      "problemMatcher": "$gcc"
    },
    {
      "label": "FluxRT: DengFOC USB-only MCPWM时序编译",
      "type": "shell",
      "command": "powershell",
      "args": ["-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}\\targets\\esp32_dengfoc\\build.ps1", "-Environment", "dengfoc_usb_mcpwm_timing"],
      "problemMatcher": "$gcc"
    },
    {
      "label": "FluxRT: H2 Ls(I) Rust-MATLAB离线重放",
      "type": "shell",
      "command": "powershell",
      "args": ["-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}\\simulation\\run_lsi_h2_replay_gate.ps1"],
      "problemMatcher": []
    }
  ]
}
