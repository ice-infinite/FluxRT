{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fluxrt.local/schema/fluxrt-lsi-h2-matrix-v1.schema.json",
  "title": "FluxRT H2 static Ls(I) matrix manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "version",
    "motor_id",
    "firmware_sha256",
    "pole_pairs",
    "requirements",
    "runs"
  ],
  "properties": {
    "contract": {"const": "fluxrt-lsi-h2-matrix"},
    "version": {"const": 1},
    "motor_id": {"type": "string", "minLength": 1},
    "firmware_sha256": {"type": "string", "pattern": "^[0-9A-Fa-f]{64}$"},
    "pole_pairs": {"type": "integer", "minimum": 1, "maximum": 255},
    "requirements": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minimum_runs",
        "angle_bin_count",
        "minimum_angle_bins",
        "minimum_angle_samples",
        "maximum_angle_span_counts",
        "maximum_phase_current_a",
        "maximum_positive_negative_asymmetry",
        "minimum_response_to_noise_ratio"
      ],
      "properties": {
        "minimum_runs": {"type": "integer", "minimum": 1},
        "angle_bin_count": {"type": "integer", "minimum": 1},
        "minimum_angle_bins": {"type": "integer", "minimum": 1},
        "minimum_angle_samples": {"type": "integer", "minimum": 1},
        "maximum_angle_span_counts": {"type": "integer", "minimum": 1},
        "maximum_phase_current_a": {"type": "number", "exclusiveMinimum": 0},
        "maximum_positive_negative_asymmetry": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "minimum_response_to_noise_ratio": {"type": "number", "minimum": 0}
      }
    },
    "runs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "motor_id",
          "firmware_sha256",
          "trace_csv_path",
          "trace_csv_sha256",
          "analysis_json_path",
          "analysis_json_sha256",
          "capture_summary_path",
          "capture_summary_sha256",
          "combined_lines_path",
          "combined_lines_sha256",
          "angle_csv_path",
          "angle_csv_sha256",
          "angle_axis",
          "angle_window_start_s",
          "angle_window_end_s"
        ],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "motor_id": {"type": "string", "minLength": 1},
          "firmware_sha256": {"type": "string", "pattern": "^[0-9A-Fa-f]{64}$"},
          "trace_csv_path": {"type": "string", "minLength": 1},
          "trace_csv_sha256": {"type": "string", "pattern": "^[0-9A-Fa-f]{64}$"},
          "analysis_json_path": {"type": "string", "minLength": 1},
          "analysis_json_sha256": {"type": "string", "pattern": "^[0-9A-Fa-f]{64}$"},
          "capture_summary_path": {"type": "string", "minLength": 1},
          "capture_summary_sha256": {"type": "string", "pattern": "^[0-9A-Fa-f]{64}$"},
          "combined_lines_path": {"type": "string", "minLength": 1},
          "combined_lines_sha256": {"type": "string", "pattern": "^[0-9A-Fa-f]{64}$"},
          "angle_csv_path": {"type": "string", "minLength": 1},
          "angle_csv_sha256": {"type": "string", "pattern": "^[0-9A-Fa-f]{64}$"},
          "angle_axis": {"type": "integer", "minimum": 0},
          "angle_window_start_s": {"type": "number", "minimum": 0},
          "angle_window_end_s": {"type": "number", "exclusiveMinimum": 0}
        }
      }
    }
  }
}
