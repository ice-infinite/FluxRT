{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ice-infinite/FluxRT/profiles/schema/fluxrt-identification-session-v1.schema.json",
  "title": "FluxRT low-risk identification screening session v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["format_version", "session_id", "created_at_utc", "purpose", "target", "conditions", "acquisition", "capabilities", "safety"],
  "properties": {
    "format_version": {"const": 1},
    "session_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{4,63}$"},
    "created_at_utc": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "purpose": {"const": "screening-only"},
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["board_id", "board_name", "motor_id", "motor_name", "pole_pairs", "profile_revision", "runtime_config_crc32", "firmware_profile", "firmware_image_path", "firmware_sha256"],
      "properties": {
        "board_id": {"$ref": "#/$defs/hexU32"},
        "board_name": {"type": "string", "minLength": 1},
        "motor_id": {"$ref": "#/$defs/hexU32"},
        "motor_name": {"type": "string", "minLength": 1},
        "pole_pairs": {"type": "integer", "minimum": 1},
        "profile_revision": {"type": "integer", "minimum": 1},
        "runtime_config_crc32": {"$ref": "#/$defs/hexU32"},
        "firmware_profile": {"const": "Diagnostic"},
        "firmware_image_path": {
          "description": "Project-relative immutable firmware artifact, or null when only the recorded digest survives. A null value is a report blocker.",
          "type": ["string", "null"],
          "minLength": 1
        },
        "firmware_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "conditions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["supply_voltage_nominal_v", "supply_current_limit_a", "load", "software_current_trip_a", "closed_loop_enabled", "ambient_temperature_c", "winding_temperature_c"],
      "properties": {
        "supply_voltage_nominal_v": {"type": "number", "exclusiveMinimum": 0},
        "supply_current_limit_a": {"type": "number", "exclusiveMinimum": 0},
        "load": {"type": "string", "minLength": 1},
        "software_current_trip_a": {"type": "number", "exclusiveMinimum": 0},
        "closed_loop_enabled": {"const": false},
        "ambient_temperature_c": {"type": ["number", "null"]},
        "winding_temperature_c": {"type": ["number", "null"]}
      }
    },
    "acquisition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trace_csv_path", "trace_csv_sha256", "raw_log_path", "raw_log_sha256", "control_frequency_hz", "trace_rate_hz", "duration_s", "target_speed_rpm"],
      "properties": {
        "trace_csv_path": {"type": "string", "minLength": 1},
        "trace_csv_sha256": {"$ref": "#/$defs/sha256"},
        "raw_log_path": {"type": "string", "minLength": 1},
        "raw_log_sha256": {"$ref": "#/$defs/sha256"},
        "control_frequency_hz": {"type": "integer", "minimum": 1},
        "trace_rate_hz": {"type": "integer", "minimum": 1, "maximum": 50},
        "duration_s": {"type": "number", "exclusiveMinimum": 0},
        "target_speed_rpm": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actual_phase_voltage_measured", "independent_speed_truth", "high_rate_current_capture", "winding_temperature_measured"],
      "properties": {
        "actual_phase_voltage_measured": {"type": "boolean"},
        "independent_speed_truth": {"type": "boolean"},
        "high_rate_current_capture": {"type": "boolean"},
        "winding_temperature_measured": {"type": "boolean"}
      }
    },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allow_motor_run_confirmed", "max_allowed_phase_current_a", "minimum_bus_voltage_v", "maximum_bus_voltage_v", "emergency_stop_command"],
      "properties": {
        "allow_motor_run_confirmed": {"const": true},
        "max_allowed_phase_current_a": {"type": "number", "exclusiveMinimum": 0},
        "minimum_bus_voltage_v": {"type": "number", "exclusiveMinimum": 0},
        "maximum_bus_voltage_v": {"type": "number", "exclusiveMinimum": 0},
        "emergency_stop_command": {"const": "foc_stop"}
      }
    }
  },
  "$defs": {
    "hexU32": {"type": "string", "pattern": "^0x[0-9A-Fa-f]{8}$"},
    "sha256": {"type": "string", "pattern": "^[0-9A-Fa-f]{64}$"}
  }
}
