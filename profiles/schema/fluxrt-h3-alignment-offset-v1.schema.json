{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fluxrt.local/schema/fluxrt-h3-alignment-offset-v1.schema.json",
  "title": "FluxRT H3 alignment electrical-offset candidate manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "version",
    "motor_id",
    "pole_pairs",
    "mechanical_direction",
    "alignment_state",
    "requirements",
    "aligned_csv_path",
    "aligned_csv_sha256",
    "parameter_approval",
    "target_capability_approval"
  ],
  "properties": {
    "contract": {"const": "fluxrt-h3-alignment-offset"},
    "version": {"const": 1},
    "motor_id": {"type": "string", "minLength": 1},
    "pole_pairs": {"type": "integer", "minimum": 1, "maximum": 255},
    "mechanical_direction": {"enum": [-1, 1]},
    "alignment_state": {"type": "integer", "minimum": 0},
    "requirements": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minimum_alignment_samples",
        "settled_tail_sample_count",
        "maximum_candidate_deviation_rad",
        "maximum_forced_angle_deviation_rad"
      ],
      "properties": {
        "minimum_alignment_samples": {"type": "integer", "minimum": 2},
        "settled_tail_sample_count": {"type": "integer", "minimum": 2},
        "maximum_candidate_deviation_rad": {"type": "number", "minimum": 0},
        "maximum_forced_angle_deviation_rad": {"type": "number", "minimum": 0}
      }
    },
    "aligned_csv_path": {"type": "string", "minLength": 1},
    "aligned_csv_sha256": {"type": "string", "pattern": "^[0-9A-Fa-f]{64}$"},
    "parameter_approval": {"const": "not-granted"},
    "target_capability_approval": {"const": "not-granted"}
  }
}
